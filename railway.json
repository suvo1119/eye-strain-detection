{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["web-app/**"]
  },
  "deploy": {
    "startCommand": "cd web-app && gunicorn --worker-class eventlet -w 1 flask_api:app --bind 0.0.0.0:$PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
